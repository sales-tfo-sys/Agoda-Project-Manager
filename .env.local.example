# このファイルを .env.local にコピーして、値を入れてください。
# .env.local は .gitignore 済みなので Git に上がりません。

# Kintone のサブドメイン（https://◯◯◯.cybozu.com の ◯◯◯ 部分）
KINTONE_SUBDOMAIN=your-subdomain

# 対象アプリのID（URL の /k/123/ の数字）
KINTONE_APP_ID=123

# アプリで発行した APIトークン（レコード閲覧のみでOK）
KINTONE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ドメイン（通常は cybozu.com。稀に s.cybozu.com などの場合のみ変更）
KINTONE_DOMAIN=cybozu.com

# ── 作業工数管理 / 作業リソース（Google スプレッドシート）──
# 既定値がコード側に入っているため通常は設定不要。別シートに切り替える場合のみ指定。
# KOSU_SHEET_ID=1mXUySyokFhE0fjjmSIjmpF2VNKGWZCzEkuwccK9UPwY
# KOSU_GID=1039908240        # 作業工数管理タブ
# RESOURCE_GID=940408510     # 作業リソースタブ

# ── Supabase（工数のサイト入力・保存に使用）──
# Supabase の Project Settings → API から取得。
# service_role キーは絶対に公開しない（サーバー側APIルートからのみ使用）。
# 設定すると /kosu/input と /kosu/tasks で入力・保存が有効になります。
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...（service_role）
# SUPABASE_ANON_KEY=eyJ...（anon。将来のクライアント認証用）

# ── セキュリティ（本番デプロイ時に設定）──
# 強制保護。初期設定（ログイン確認）が済んだら本番では 1 にする。
# これで許可リスト照会が一時的に失敗しても全公開に落ちない。
# AUTH_REQUIRED=1
# パスワードログインの有効化（既定＝無効／Googleのみ）。
# Google が使えない緊急時だけ 1 にする。
# PASSWORD_LOGIN=1

# ── フォーム回答（非公開シートを読む場合・任意）──
# サービスアカウントを設定すると、フォーム回答ページで「公開」せずに
# 非公開シートを読める（対象シートをこのメールに閲覧共有するだけでOK）。
# 未設定なら「リンクを知っている全員が閲覧可」のシートのみ読める。
# GOOGLE_SA_EMAIL=xxxxx@yyyyy.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google ドライブ連携（作業シートのアップロード／フォルダ移動・任意）──
# 置き場所が個人のマイドライブなので、サービスアカウントのままでは保存容量が無く
# ファイルを作れない。Google Workspace の「ドメイン全体の委任」で実在ユーザーに
# なりすまして操作する。設定手順：
#   1. Google Cloud でサービスアカウントを作り、JSONキーを発行
#   2. そのサービスアカウントで「ドメイン全体の委任」を有効化し、クライアントIDを控える
#   3. Workspace 管理コンソール → セキュリティ → アクセスとデータ管理 → APIの制御
#      → ドメイン全体の委任 → 上のクライアントIDと、スコープ
#        https://www.googleapis.com/auth/drive を登録
#   4. Google Cloud で Drive API（と Sheets API）を有効化
# GOOGLE_SA_EMAIL=xxxxx@yyyyy.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 代理するユーザー（フォルダの持ち主）。これが無いとアップロードは動かない。
# GOOGLE_DRIVE_USER=sales-tfo@thefirstone.jp
# 置き場所のフォルダID（未設定ならコード側の既定値を使う）
# GOOGLE_DRIVE_FOLDER_NEW=1KFnrcBpPbilgC20wOFlRm-yOpq-tfIha
# GOOGLE_DRIVE_FOLDER_DONE=1ZN1KOn5Ob2jT3dZm5wf_S5-WrvsbS2mm
# GOOGLE_DRIVE_FOLDER_HOLD=1Qi8GMVPSywyle1rr1UftHLicSxZry2g7
